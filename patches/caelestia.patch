+					if (isDrop) droppedFrames++;
+
+					static std::ofstream logFile("/tmp/telegram_anim_perf.log", std::ios::app);
+					if (logFile.is_open()) {
+						logFile << (isDrop ? "[PERF DROP!] " : "[PERF] ")
+								<< "Frame #" << frameCount
+								<< " dt=" << dtMs << "ms"
+								<< " fps=" << currentFps
+								<< " paint=" << lastPaintTimeMs << "ms"
+								<< " y=" << currentY
+								<< std::endl;
+					}
+				}
+				isIdle = false;
+			} else {
+				if (dtMs > 25.0) {
+					isIdle = true;
+				} else if (dtMs > 0.1) {
+					currentFps = 1000.0 / dtMs;
+					isIdle = false;
+					static std::ofstream logFile("/tmp/telegram_anim_perf.log", std::ios::app);
+					if (logFile.is_open()) {
