+				static std::ofstream logFile("/tmp/telegram_anim_perf.log", std::ios::app);
+				if (logFile.is_open()) {
+					logFile << "=== BENCHMARK SUMMARY ===\n"
+							<< "  Total Frames : " << frameCount << "\n"
+							<< "  Total Time   : " << totalFrameTimeMs << " ms\n"
+							<< "  Avg FPS      : " << avgFps << "\n"
+							<< "  1% Low FPS   : " << low1Fps << "\n"
+							<< "  Max FrameTime: " << maxFrameTimeMs << " ms\n"
+							<< "  Min FrameTime: " << minFrameTimeMs << " ms\n"
+							<< "  Dropped (>12ms): " << droppedFrames << " ("
+							<< (frameCount ? (droppedFrames * 100.0 / frameCount) : 0) << "%)\n"
+							<< "=========================\n" << std::endl;
+				}
+			}
+		}
+		wasAnimating = isAnimating;
+		lastFrameTime = now;
+	}
