+								<< std::endl;
+					}
+				}
+			}
+		}
+		if (isAnimating && !wasAnimating) {
+			animStartTime = now;
+			frameCount = 0;
+			droppedFrames = 0;
+			totalFrameTimeMs = 0.0;
+			maxFrameTimeMs = 0.0;
+			minFrameTimeMs = 999.0;
+			frameDeltas.clear();
+			isIdle = false;
+			static std::ofstream logFile("/tmp/telegram_anim_perf.log", std::ios::app);
+			if (logFile.is_open()) {
+				logFile << "\n=== ANIMATION BENCHMARK STARTED ===" << std::endl;
+			}
+		} else if (!isAnimating && wasAnimating) {
+			if (!frameDeltas.empty()) {
+				avgFps = (frameCount * 1000.0) / std::max(0.001, totalFrameTimeMs);
+				std::sort(frameDeltas.begin(), frameDeltas.end());
+				const auto p99Index = int(frameDeltas.size() * 0.99);
+				const auto p99Dt = frameDeltas[std::min(p99Index, int(frameDeltas.size() - 1))];
